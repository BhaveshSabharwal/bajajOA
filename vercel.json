{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/bfhl",
      "dest": "/backend/server.js",
      "methods": [
        "POST"
      ]
    },
    {
      "src": "/apiCheck",
      "dest": "/backend/server.js",
      "methods": [
        "GET"
      ]
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}